# Application
APP_SERVER_PORT=8080
APP_SERVER_MODE=debug

# PostgreSQL
APP_DATABASE_DRIVER=postgres
APP_DATABASE_HOST=localhost
APP_DATABASE_PORT=5432
APP_DATABASE_USER=app
APP_DATABASE_PASSWORD=change-me
APP_DATABASE_DBNAME=app
APP_DATABASE_SSLMODE=disable

# Redis
APP_REDIS_HOST=localhost
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=
APP_REDIS_DB=0

# MinIO
APP_MINIO_ENDPOINT=localhost:9000
APP_MINIO_ACCESSKEY=app
APP_MINIO_SECRETKEY=change-me
APP_MINIO_BUCKET=app-files
APP_MINIO_USESSL=false

# JWT
APP_JWT_SECRET=change-me-in-production
APP_JWT_EXPIRATION=24

# Log
APP_LOG_LEVEL=debug
APP_LOG_FORMAT=text